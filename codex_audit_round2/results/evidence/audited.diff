+    # Correct: sqrt(mean([1, 25])) = sqrt(13) ~ 3.606
+    rmse_correct = weighted_rmse(prediction, target, convention=WeightConvention.WEIGHTED_MEAN)
+    expected_correct = torch.sqrt(torch.tensor(13.0, dtype=DT))

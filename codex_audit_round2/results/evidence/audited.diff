+        )
+
+        out_diff = controlled_rollout(
+            trained_bridge, x_norm, small_variables,
+            interval=6, steps=2, plan=plan, expert_loras={},
+            differentiable=True,
+        )
+
+    assert torch.allclose(out_normal, out_diff, atol=1e-6)

+            code = {
+                'history': 'ADMISSION_HISTORY_ENDPOINT_MISSING',
+                'issue': 'ADMISSION_CURRENT_ENDPOINT_MISSING',
+                'target': 'ADMISSION_TARGET_ENDPOINT_MISSING',

+    q_eff = effective_quadratic_weight(
+        q, scale, tuple(prediction.shape), device=prediction.device
+    )
+    diff = prediction.to(_OBJECTIVE_DTYPE) - target_aligned.to(_OBJECTIVE_DTYPE)
+    return q_eff.quadratic_form(diff, diff)

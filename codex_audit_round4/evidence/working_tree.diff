+def test_full_objective_endpoint_difference_equals_analytic_gain():
+    """B06 core identity: L(F) - L(F+u) == full_objective_gain(Y-F, u)."""
+    torch.manual_seed(20260921)
+    B, K, H, V, LAT, LON = 2, 3, 3, 2, 4, 5

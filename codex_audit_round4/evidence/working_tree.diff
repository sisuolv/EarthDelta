+            expected_channels=expected_channels,
+            sigma_bound=content_sigma_bound,
+            normalization_dir=normalization_dir,
+            require_physical_range=require_physical_range,
+            data_role=role,
+            issue_id=issue_id,
+            process_group_id=process_group,

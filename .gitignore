# Third-party reference clones (46 repos, ~3 GB) are NOT tracked.
# Re-create them with reference/_clone_refs*.sh; the manifest records the pinned HEADs.
reference/*
!reference/README.md
!reference/_manifest.json
!reference/_clone_refs*.sh

# Data and large artifacts
/data/
/artifacts/
*.ckpt
*.pt
*.pth
*.zarr/
*.h5
*.hdf5
*.nc
*.grib
*.grib2
*.npy
*.npz

# Python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.venv/
.env

# Local pip --target install dir (persistent-AFS workaround for /root wipe on
# container restart); not source code, reinstalled from PyPI as needed.
/.pydeps/
# Separate CPU-jax install for the WeatherBench-X/WB2 evaluation path only
# (earthdelta/wbx). Kept apart so the frozen .pydeps above is never modified.
/.pydeps_wbx/

# Ephemeral run logs
checkpoints/*.log

# Build artifacts
*.egg-info/

# Misc
.DS_Store
nohup.out
